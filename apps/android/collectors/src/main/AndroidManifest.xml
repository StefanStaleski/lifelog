<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Special access, granted by the user in Settings → Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- App labels and categories for usage stats (sideloaded app, not on Play). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Steps and distance from Health Connect (Samsung Health syncs into it). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Activity Recognition transitions (still / walking / vehicle ...). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Named places (geofences) and stays elsewhere; "all the time" because collection runs in the background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application>
        <!-- Counts notifications per app per hour (special access, granted in Settings). -->
        <service
            android:name=".notifications.LifelogNotificationListener"
            android:exported="true"
            android:label="Lifelog notification counter"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".places.GeofenceReceiver"
            android:exported="false" />
        <receiver
            android:name=".activity.ActivityTransitionReceiver"
            android:exported="false" />
    </application>

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
