# Copy to apps/web/.env.local (git-ignored). Real values live in Vercel env settings.

# Supabase pooler connection string (transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Long random token the phone sends in the Authorization header (openssl rand -hex 32)
DEVICE_TOKEN=

# Cloud DB password (used by scripts/setup-supabase.sh and `supabase link`)
SUPABASE_DB_PASSWORD=

# Server-only; never expose to the browser or the Android app
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
