# Copy to apps/web/.env.local (git-ignored). Real values live in Vercel env settings.

# Supabase pooler connection string (transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Long random token the phone sends in the Authorization header (openssl rand -hex 32)
DEVICE_TOKEN=

# Cloud DB password (used by scripts/setup-supabase.sh and `supabase link`)
SUPABASE_DB_PASSWORD=

# Dashboard sign-in (Supabase Auth magic link). The anon key is public by design; RLS keeps it from reading data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The only address allowed into the dashboard
DASHBOARD_EMAIL=
# Vercel Cron sends this as a bearer token to /api/v1/jobs/daily (weather)
CRON_SECRET=

# Name shown on the dossier
DOSSIER_NAME=

# Local only: skip sign-in in `next dev` (ignored in production and on Vercel)
# DASHBOARD_DEV_AUTH_BYPASS=1
